# Copy to .env and fill in. Every value has a sensible default.

# ---------------------------------------------------------------- LLM (Google Gemini via google-genai)
# Get a key at https://aistudio.google.com/apikey . Without a key, QUORUM still runs:
# every agent falls back to the rule-based offline engine (clearly labelled in the UI).
GEMINI_API_KEY=
# Any Gemini model id. The "-latest" alias tracks Google's current Flash model;
# pin a specific id (e.g. a dated Flash model) for reproducible results.
GEMINI_MODEL=gemini-flash-latest
# Optional, Gemini 3+ models only: minimal | low | medium | high. Empty = model default.
GEMINI_THINKING_LEVEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45

# Evaluation only uses as-of dates AFTER this date, to avoid look-ahead bias.
# Set it to the documented knowledge cutoff of GEMINI_MODEL (be conservative with -latest aliases).
LLM_KNOWLEDGE_CUTOFF=2026-06-30

# ---------------------------------------------------------------- demo reliability
# true = use cached sample data for INFY and TATAMOTORS (backend/demo_data) so a live
# demo never depends on Yahoo Finance / Google News. Cached data is also used
# automatically whenever those APIs fail.
DEMO_MODE=false

# ---------------------------------------------------------------- simulation
INITIAL_CASH=100000
DEBATE_ROUNDS=3
CACHE_TTL_SECONDS=900
# Delay between streamed chunks of the offline engine (seconds) - purely cosmetic.
OFFLINE_TOKEN_DELAY=0.03

# ---------------------------------------------------------------- evaluation
EVAL_TICKERS=INFY,TCS,RELIANCE,HDFCBANK,ICICIBANK,SBIN,ITC,BHARTIARTL,LT,TATAMOTORS
# Debate rounds per ticker during evaluation (fewer rounds = fewer LLM calls).
EVAL_DEBATE_ROUNDS=1
# A HOLD counts as correct if the forward return stays within +/- this band.
EVAL_HOLD_BAND=0.02
